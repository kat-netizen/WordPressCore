{
    "name": "WordPress Dev Environment",
    "image": "mcr.microsoft.com/devcontainers/php:8.3",
    "forwardPorts": [8080],
    "portsAttributes": {
        "8080": {
            "label": "WordPress",
            "onAutoForward": "notify"
        }
    },
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "postStartCommand": "sudo service mariadb start",
    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "xdebug.php-debug"
            ]
        }
    }
}
